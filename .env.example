# ══════════════════════════════════════════════════════════════════════════════
# MeyREN Gateway & Management Panel Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Core Security
ADMIN_PASSWORD=admin
SECRET_KEY=change_this_to_a_secure_random_string_in_production
DEFAULT_DOMAIN=localhost

# Networking & Ports
PORT=8000
HOST=0.0.0.0

# Telegram Companion Bot (Optional - leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Database & Storage (Default: SQLite in root directory)
DB_PATH=meyren.db
